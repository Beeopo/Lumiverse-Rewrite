{
  "version": "1.4.0",
  "name": "Rewrite",
  "identifier": "rewrite_assistant",
  "author": "Beeopo",
  "github": "https://github.com/Beeopo/Lumiverse-Rewrite",
  "homepage": "https://github.com/Beeopo/Lumiverse-Rewrite",
  "description": "Select text in a message and rewrite it in place with an LLM style profile. Panel-driven with Watch mode.",
  "permissions": [
    "generation",
    "chat_mutation",
    "characters",
    "personas",
    "memories",
    "world_books"
  ],
  "entry_backend": "dist/backend.js",
  "entry_frontend": "dist/frontend.js",
  "minimum_lumiverse_version": "1.1.0",
  "dev_mode": true
}
